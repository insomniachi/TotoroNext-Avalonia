<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TotoroNext.Anime.ViewModels"
             xmlns:module="clr-namespace:TotoroNext.Module;assembly=TotoroNext.Module"
             xmlns:ext="totoro.next/extensions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Width="400"
             x:DataType="viewModels:RelationsBuilderViewModel"
             x:Class="TotoroNext.Anime.Views.RelationsBuilderView">
    <Grid RowDefinitions="Auto,*" RowSpacing="4">
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Height" Value="15" />
                    <Setter Property="Width" Value="30" />
                    <Setter Property="CommandParameter" Value="{Binding #TheDataGrid.SelectedItem}" />
                </Style>
                <Style Selector="Viewbox">
                    <Setter Property="Height" Value="15" />
                    <Setter Property="Width" Value="15" />
                </Style>
            </StackPanel.Styles>
            <Button
                Command="{Binding MoveUpCommand}">
                <Viewbox Child="{ext:PathIcon Key={x:Static module:CommonIcons.ArrowUp}}" />
            </Button>
            <Button
                Command="{Binding MoveDownCommand}">
                <Viewbox Child="{ext:PathIcon Key={x:Static module:CommonIcons.ArrowDown}}" />
            </Button>
            <Button
                Command="{Binding DeleteCommand}">
                <Viewbox Child="{ext:PathIcon Key={x:Static module:CommonIcons.Delete}}" />
            </Button>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Anime}"
                  GridLinesVisibility="All"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserSortColumns="True"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  SelectedItem="{Binding SelectedRow}"
                  x:Name="TheDataGrid">
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="DragDrop.AllowDrop" Value="True" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Title}"
                                    Header="Title"
                                    IsReadOnly="True"
                                    Width="*" />
                <DataGridTextColumn Binding="{Binding TotalEpisodes}"
                                    Header="Episodes" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</ContentPage>